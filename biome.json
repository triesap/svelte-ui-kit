{
  "$schema": "https://biomejs.dev/schemas/2.6.8/schema.json",
  "vcs": {
    "enabled": true,
    "clientKind": "git",
    "useIgnoreFile": true
  },
  "files": {
    "ignoreUnknown": true,
    "includes": [
      "**",
      "!**/node_modules",
      "!**/.pnpm-store",
      "!**/.native-build",
      "!**/dist",
      "!**/build",
      "!**/.svelte-kit",
      "!**/coverage",
      "!**/.unit-test-build",
      "!**/.output",
      "!**/playwright-report",
      "!tests/fixtures/generated",
      "!.artifacts",
      "!implementation/evidence/logs",
      "!**/pnpm-lock.yaml",
      "!tools/native-dependency/*.pnpm-lock.yaml"
    ]
  },
  "formatter": {
    "enabled": true,
    "indentStyle": "space",
    "indentWidth": 2,
    "lineWidth": 80,
    "lineEnding": "lf"
  },
  "linter": {
    "enabled": true,
    "rules": {
      "preset": "recommended",
      "suspicious": {
        "noImplicitAnyLet": "off"
      },
      "style": {
        "noNonNullAssertion": "off"
      },
      "complexity": {
        "useOptionalChain": "off"
      }
    }
  },
  "assist": {
    "enabled": false
  },
  "javascript": {
    "formatter": {
      "quoteStyle": "double",
      "trailingCommas": "all",
      "semicolons": "always"
    }
  },
  "html": {
    "experimentalFullSupportEnabled": true,
    "formatter": {
      "enabled": true
    }
  },
  "overrides": [
    {
      "includes": [
        "**/*.svelte",
        "**/*.astro",
        "**/*.md",
        "**/*.yaml",
        "**/*.yml"
      ],
      "formatter": {
        "enabled": false
      }
    },
    {
      "includes": ["tests/**/*.svelte"],
      "linter": {
        "rules": {
          "a11y": {
            "useButtonType": "off"
          }
        }
      }
    },
    {
      "includes": ["assets/registry/ui/field/label.svelte"],
      "linter": {
        "rules": {
          "a11y": {
            "noLabelWithoutControl": "off"
          }
        }
      }
    },
    {
      "includes": [
        "assets/registry/ui/separator.svelte",
        "tests/fixtures/qualification/skeleton/+page.svelte"
      ],
      "linter": {
        "rules": {
          "a11y": {
            "useAriaPropsSupportedByRole": "off"
          }
        }
      }
    },
    {
      "includes": ["tests/fixtures/qualification/separator/+page.svelte"],
      "linter": {
        "rules": {
          "a11y": {
            "useSemanticElements": "off"
          }
        }
      }
    },
    {
      "includes": ["tests/**/*.ts"],
      "linter": {
        "rules": {
          "performance": {
            "useDomNodeTextContent": "off"
          }
        }
      }
    },
    {
      "includes": [
        "assets/registry/ui/field/owned-message.svelte",
        "tests/browser/fault-run.spec.ts"
      ],
      "linter": {
        "rules": {
          "suspicious": {
            "noConfusingVoidType": "off"
          }
        }
      }
    }
  ]
}
