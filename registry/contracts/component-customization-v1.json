{
  "id": "urn:svelte-ui-kit:component-customization:v1",
  "contractVersion": 1,
  "description": "Independent inherited component CSS overrides, including exact geometry-critical radius overrides.",
  "properties": [
    {
      "name": "--kit-spinner-inline-size",
      "scope": "spinner",
      "grammar": "<length-percentage>",
      "fallback": "1em"
    },
    {
      "name": "--kit-spinner-block-size",
      "scope": "spinner",
      "grammar": "<length-percentage>",
      "fallback": "1em"
    },
    {
      "name": "--kit-spinner-border-width",
      "scope": "spinner",
      "grammar": "<length>",
      "fallback": "0.125em"
    },
    {
      "name": "--kit-spinner-track-color",
      "scope": "spinner",
      "grammar": "<color>",
      "fallback": "color-mix(in srgb, currentColor 20%, transparent)"
    },
    {
      "name": "--kit-spinner-color",
      "scope": "spinner",
      "grammar": "<color>",
      "fallback": "currentColor"
    },
    {
      "name": "--kit-spinner-animation-duration",
      "scope": "spinner",
      "grammar": "<time>",
      "fallback": "900ms"
    },
    {
      "name": "--kit-radius-default",
      "scope": "semantic",
      "grammar": "<length-percentage>{1,4} [ / <length-percentage>{1,4} ]? | inherit | initial | unset | revert | revert-layer",
      "fallback": "var(--kit-radius-md)"
    },
    {
      "name": "--kit-radius-control",
      "scope": "semantic",
      "grammar": "<length-percentage>{1,4} [ / <length-percentage>{1,4} ]? | inherit | initial | unset | revert | revert-layer",
      "fallback": "var(--kit-radius-default, var(--kit-radius-md))"
    },
    {
      "name": "--kit-radius-surface",
      "scope": "semantic",
      "grammar": "<length-percentage>{1,4} [ / <length-percentage>{1,4} ]? | inherit | initial | unset | revert | revert-layer",
      "fallback": "var(--kit-radius-default, var(--kit-radius-lg))"
    },
    {
      "name": "--kit-radius-overlay",
      "scope": "semantic",
      "grammar": "<length-percentage>{1,4} [ / <length-percentage>{1,4} ]? | inherit | initial | unset | revert | revert-layer",
      "fallback": "var(--kit-radius-default, var(--kit-radius-md))"
