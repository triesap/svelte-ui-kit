{
  "schemaVersion": 1,
  "id": "anchor",
  "kind": "component",
  "version": "0.1.2",
  "description": "Native typed link presentation with source target and rel safety defaults.",
  "compatibility": {
    "svelte": "5.57.3",
    "bits": "2.20.2-svelte-ui-kit.1",
    "date": "^3.8.1"
  },
  "files": [
    {
      "source": "ui/anchor.svelte",
      "target": "anchor.svelte",
      "kind": "svelte",
      "cohort": "anchor"
    },
    {
      "source": "ui/anchor.types.ts",
      "target": "anchor.types.ts",
      "kind": "typescript",
      "cohort": "anchor"
    }
  ],
  "exports": [
    {
      "name": "Anchor",
      "target": "anchor.svelte",
      "kind": "value"
    },
    {
      "name": "AnchorProps",
      "target": "anchor.types.ts",
      "kind": "type"
    },
    {
      "name": "AnchorTarget",
      "target": "anchor.types.ts",
      "kind": "type"
    }
  ],
  "styles": [
    {
      "source": "styles/anchor.css",
      "target": "kit.css",
      "blockId": "anchor",
      "cohort": "anchor"
    }
  ],
  "registryDependencies": ["tokens"],
  "npmDependencies": [],
  "accessibility": {
    "requiredNames": ["link-text-or-explicit-name"],
    "keyboard": ["Enter"],
    "focus": ["native-link-focus"],
    "form": [],
    "tests": ["anchor-types", "anchor-install", "anchor"]
  }
}
