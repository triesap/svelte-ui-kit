{
  "schemaVersion": 1,
  "id": "avatar",
  "kind": "component",
  "version": "0.1.2",
  "description": "Native image avatar with accessible optional loading and failure fallback.",
  "compatibility": {
    "svelte": "5.57.1",
    "bits": "2.19.5-svelte-ui-kit.2",
    "date": "^3.8.1"
  },
  "files": [
