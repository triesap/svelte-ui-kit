      "source": "ui/avatar.svelte",
      "target": "avatar.svelte",
      "kind": "svelte",
      "cohort": "avatar"
    },
    {
      "source": "ui/avatar.types.ts",
      "target": "avatar.types.ts",
      "kind": "typescript",
      "cohort": "avatar"
    }
  ],
  "exports": [
    {
      "name": "Avatar",
      "target": "avatar.svelte",
      "kind": "value"
    },
    {
      "name": "AvatarProps",
      "target": "avatar.types.ts",
      "kind": "type"
    }
  ],
  "styles": [
    {
      "source": "styles/avatar.css",
      "target": "kit.css",
      "blockId": "avatar",
      "cohort": "avatar"
    }
