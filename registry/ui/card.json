{
  "schemaVersion": 1,
  "id": "card",
  "kind": "component",
  "version": "0.1.0",
  "description": "Native sectioning surface with application-owned content and source card styles.",
  "compatibility": {
    "svelte": "5.57.1",
    "bits": "2.19.3",
    "date": "^3.8.1"
  },
  "files": [
    {
      "source": "ui/card.svelte",
      "target": "card.svelte",
      "kind": "svelte",
      "cohort": "card"
    },
    {
      "source": "ui/card.types.ts",
      "target": "card.types.ts",
      "kind": "typescript",
      "cohort": "card"
    }
  ],
  "exports": [
    {
      "name": "Card",
      "target": "card.svelte",
      "kind": "value"
    },
    {
      "name": "CardProps",
      "target": "card.types.ts",
      "kind": "type"
    }
  ],
  "styles": [
    {
      "source": "styles/card.css",
      "target": "kit.css",
      "blockId": "card",
      "cohort": "card"
    }
  ],
  "registryDependencies": ["tokens"],
  "npmDependencies": [],
  "accessibility": {
    "requiredNames": ["application-heading-when-distinct-section"],
    "keyboard": [],
    "focus": [],
    "form": [],
    "tests": ["card-types", "card-css", "card-install", "card"]
  }
}
