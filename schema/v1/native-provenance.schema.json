{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "urn:svelte-ui-kit:schema:v1:native-provenance",
  "title": "Qualified native distribution provenance v1",
  "description": "A source-built native artifact description. Readiness also requires the CLI's fixed archive/provenance identity and actual installed file authentication; this record never certifies itself.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "name",
    "version",
    "variant",
    "nativeSource",
    "emitterSource",
    "patchSha256",
    "recipeSha256",
    "producerLocks",
    "emitterArchiveSha256",
    "toolchain",
    "distributionFiles"
  ],
  "properties": {
    "schemaVersion": { "const": 1 },
    "name": { "const": "bits-ui" },
    "version": { "type": "string", "minLength": 1 },
    "variant": {
      "enum": ["source-emitter-binding-signature", "unpatched-causal-control"]
    },
    "nativeSource": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "repository",
        "revision",
        "packagePath",
        "sourceVersion",
        "buildVersion",
        "archive",
        "archiveSha256"
      ],
      "properties": {
        "repository": { "type": "string", "format": "uri" },
        "revision": { "$ref": "#/definitions/revision" },
        "packagePath": { "type": "string", "minLength": 1 },
        "sourceVersion": { "type": "string", "minLength": 1 },
        "buildVersion": { "type": "string", "minLength": 1 },
        "archive": { "type": "string", "pattern": "^[A-Za-z0-9._-]+\\.tgz$" },
        "archiveSha256": { "$ref": "#/definitions/digest" }
      }
    },
    "emitterSource": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "repository",
        "revision",
        "sourceManifestVersion",
        "sourceTag",
        "buildVersion",
        "archiveSha256"
      ],
      "properties": {
        "repository": { "type": "string", "format": "uri" },
        "revision": { "$ref": "#/definitions/revision" },
        "sourceManifestVersion": { "type": "string", "minLength": 1 },
        "sourceTag": { "type": "string", "minLength": 1 },
        "buildVersion": { "type": "string", "minLength": 1 },
        "archiveSha256": { "$ref": "#/definitions/digest" }
      }
    },
    "patchSha256": {
      "anyOf": [{ "$ref": "#/definitions/digest" }, { "type": "null" }]
    },
    "recipeSha256": { "$ref": "#/definitions/digest" },
    "producerLocks": {
      "type": "object",
      "additionalProperties": false,
      "required": ["emitter", "native"],
      "properties": {
        "emitter": { "$ref": "#/definitions/digest" },
        "native": { "$ref": "#/definitions/digest" }
      }
    },
    "emitterArchiveSha256": { "$ref": "#/definitions/digest" },
    "toolchain": {
      "type": "object",
      "additionalProperties": false,
      "required": ["node", "pnpm", "emitter", "native"],
      "properties": {
        "node": { "type": "string", "minLength": 1 },
        "pnpm": { "type": "string", "minLength": 1 },
        "emitter": { "$ref": "#/definitions/versionMap" },
        "native": { "$ref": "#/definitions/versionMap" }
      }
    },
    "distributionFiles": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["path", "sha256"],
        "properties": {
          "path": { "type": "string", "minLength": 1 },
          "sha256": { "$ref": "#/definitions/digest" }
        }
      }
    }
  },
  "definitions": {
    "digest": { "type": "string", "pattern": "^[0-9a-f]{64}$" },
    "revision": { "type": "string", "pattern": "^[0-9a-f]{40}$" },
    "versionMap": {
      "type": "object",
      "minProperties": 1,
      "additionalProperties": { "type": "string", "minLength": 1 }
    }
  }
}
