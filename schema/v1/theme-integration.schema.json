{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "urn:svelte-ui-kit:schema:v1:theme-integration",
  "title": "svelte-ui-kit theme integration (v1)",
  "description": "Stylesheet path, layer order, producer and actual portal capabilities. Never a Rust ABI or primitive-package claim.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "id",
    "contractVersion",
    "description",
    "stylesheet",
    "layers",
    "producer",
    "compatibility",
    "portal",
    "tokenContract"
  ],
  "properties": {
    "id": { "const": "urn:svelte-ui-kit:theme-integration:v1" },
    "contractVersion": { "const": 1 },
    "description": { "type": "string", "minLength": 1 },
    "stylesheet": { "type": "string", "pattern": "^[^/].*\\.css$" },
    "layers": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {
        "enum": [
          "svelte-ui-kit.tokens",
          "svelte-ui-kit.themes",
          "svelte-ui-kit.components"
        ]
      }
    },
    "producer": { "const": "svelte-ui-kit" },
    "compatibility": {
      "type": "object",
      "additionalProperties": false,
      "required": ["svelte", "bits", "date"],
      "properties": {
        "svelte": { "type": "string", "minLength": 1 },
        "bits": { "type": "string", "minLength": 1 },
        "date": { "type": "string", "minLength": 1 }
      }
    },
    "portal": {
      "type": "object",
      "additionalProperties": false,
      "required": ["supported", "strategies"],
      "properties": {
        "supported": { "const": true },
        "strategies": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": { "enum": ["document", "custom-host"] }
        }
      }
    },
    "tokenContract": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "contractVersion"],
      "properties": {
        "id": { "type": "string", "minLength": 1 },
        "contractVersion": { "type": "integer", "minimum": 1 }
      }
    }
  }
}
