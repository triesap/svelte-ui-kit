{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "urn:svelte-ui-kit:schema:v1:token-contract",
  "title": "svelte-ui-kit token contract (v1)",
  "description": "Semantic token vocabulary, layer order and the full border-radius grammar contract. Independent of the component-customization and theme-integration contracts.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "id",
    "contractVersion",
    "description",
    "layers",
    "tokens",
    "radiusGrammar"
  ],
  "properties": {
    "id": { "const": "urn:svelte-ui-kit:token-contract:v1" },
    "contractVersion": { "const": 1 },
    "description": { "type": "string", "minLength": 1 },
    "layers": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {
        "enum": [
          "svelte-ui-kit.tokens",
          "svelte-ui-kit.themes",
          "svelte-ui-kit.components"
        ]
      }
    },
    "tokens": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["name", "role", "type", "fallback"],
        "properties": {
          "name": {
            "type": "string",
            "pattern": "^--kit-[a-z0-9-]+$"
          },
          "role": {
            "enum": [
              "color",
              "text",
              "surface",
              "border",
              "focus",
              "shadow",
              "motion",
              "easing",
              "radius",
              "spacing",
              "typography",
              "opacity"
            ]
          },
          "type": {
            "enum": [
              "color",
              "length",
              "duration",
              "number",
              "string",
              "shadow"
            ]
          },
          "fallback": { "type": "string" }
        }
      }
    },
    "radiusGrammar": {
      "description": "Structural declaration that the contract preserves full CSS border-radius grammar (four corners with elliptical slash form).",
      "type": "object",
      "additionalProperties": false,
      "required": ["corners", "elliptical", "slashSeparator"],
      "properties": {
        "corners": { "const": 4 },
        "elliptical": { "const": true },
        "slashSeparator": { "const": true }
      }
    }
  }
}
