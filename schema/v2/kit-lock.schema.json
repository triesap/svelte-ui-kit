{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "urn:svelte-ui-kit:schema:v2:kit-lock",
  "title": "Explicit application target install lock (v2)",
  "description": "Observed installed lineage. Canonical owner records only; no redundant reverse index is stored. S020 adds managed CSS blocks and integration records.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "toolVersion",
    "registryVersion",
    "registryHash",
    "configHash",
    "requested",
    "items",
    "files",
    "cssBlocks",
    "integrations",
    "target"
  ],
  "properties": {
    "schemaVersion": {
      "const": 2
    },
    "toolVersion": {
      "type": "string",
      "minLength": 1
    },
    "registryVersion": {
      "type": "string",
      "minLength": 1
    },
    "registryHash": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "configHash": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "requested": {
      "description": "Sorted explicit root requests, kept separate from the resolved closure.",
      "type": "array",
      "items": {
        "type": "string",
        "pattern": "^[a-z][a-z0-9]*(?:-[a-z0-9]+)*$"
      },
      "uniqueItems": true
    },
    "items": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "version", "digest", "origin"],
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^[a-z][a-z0-9]*(?:-[a-z0-9]+)*$"
          },
          "version": {
            "type": "string",
            "minLength": 1
          },
          "digest": {
            "type": "string",
            "pattern": "^[0-9a-f]{64}$"
          },
          "origin": {
            "enum": ["explicit", "transitive"]
          }
        }
      }
    },
    "files": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["path", "owner", "baseHash", "itemVersion", "cohort"],
        "properties": {
          "path": {
            "type": "string",
            "minLength": 1
          },
          "owner": {
            "type": "string",
            "pattern": "^[a-z][a-z0-9]*(?:-[a-z0-9]+)*$"
          },
          "baseHash": {
            "type": "string",
            "pattern": "^[0-9a-f]{64}$"
          },
          "itemVersion": {
            "type": "string",
            "minLength": 1
          },
          "cohort": {
            "type": "string",
            "pattern": "^[a-z][a-z0-9]*(?:-[a-z0-9]+)*$"
          }
        }
      }
    },
    "cssBlocks": {
      "description": "Managed CSS blocks, tracked per block so one aggregate stylesheet can have several owners.",
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "path",
          "owner",
          "blockId",
          "baseHash",
          "itemVersion",
          "cohort"
        ],
        "properties": {
          "path": {
            "type": "string",
            "minLength": 1
          },
          "owner": {
            "type": "string",
            "pattern": "^[a-z][a-z0-9]*(?:-[a-z0-9]+)*$"
          },
          "blockId": {
            "type": "string",
            "pattern": "^[a-z][a-z0-9]*(?:-[a-z0-9]+)*$"
          },
          "baseHash": {
            "type": "string",
            "pattern": "^[0-9a-f]{64}$"
          },
          "itemVersion": {
            "type": "string",
            "minLength": 1
          },
          "cohort": {
            "type": "string",
            "pattern": "^[a-z][a-z0-9]*(?:-[a-z0-9]+)*$"
          }
        }
      }
    },
    "integrations": {
      "description": "Managed layout/stylesheet/export integration provenance.",
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["kind", "path", "baseline", "contract"],
        "properties": {
          "kind": {
            "enum": ["layout", "stylesheet", "exports", "stylesheet-entry"]
          },
          "path": {
            "type": "string",
            "minLength": 1
          },
          "baseline": {
            "type": "string",
            "pattern": "^[0-9a-f]{64}$"
          },
          "contract": {
            "type": "string",
            "minLength": 1
          }
        },
        "oneOf": [
          {
            "properties": {
              "kind": {
                "const": "layout"
              },
              "contract": {
                "enum": ["layout-v1", "astro-layout-v1"]
              }
            }
          },
          {
            "properties": {
              "kind": {
                "const": "stylesheet"
              },
              "contract": {
                "enum": ["foundation-tokens-v1", "stylesheet-v1"]
              }
            }
          },
          {
            "properties": {
              "kind": {
                "const": "exports"
              },
              "contract": {
                "const": "exports-v1"
              }
            }
          },
          {
            "properties": {
              "kind": {
                "const": "stylesheet-entry"
              },
              "contract": {
                "const": "library-styles-v1"
              },
              "path": {
                "type": "string",
                "pattern": "\\.css$"
              }
            }
          }
        ]
      },
      "maxItems": 3
    },
    "target": {
      "enum": ["sveltekit", "astro", "svelte-library"]
    }
  },
  "allOf": [
    {
      "properties": {
        "integrations": {
          "contains": {
            "properties": {
              "kind": {
                "enum": ["layout", "stylesheet-entry"]
              }
            },
            "required": ["kind"]
          }
        }
      }
    },
    {
      "properties": {
        "integrations": {
          "contains": {
            "properties": {
              "kind": {
                "const": "stylesheet"
              }
            },
            "required": ["kind"]
          }
        }
      }
    },
    {
      "properties": {
        "integrations": {
          "contains": {
            "properties": {
              "kind": {
                "const": "exports"
              }
            },
            "required": ["kind"]
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "target": {
            "const": "astro"
          }
        }
      },
      "then": {
        "properties": {
          "integrations": {
            "contains": {
              "properties": {
                "kind": {
                  "const": "layout"
                },
                "contract": {
                  "const": "astro-layout-v1"
                }
              },
              "required": ["kind", "contract"]
            }
          }
        }
      },
      "else": {
        "if": {
          "properties": {
            "target": {
              "const": "svelte-library"
            }
          }
        },
        "then": {
          "properties": {
            "integrations": {
              "contains": {
                "properties": {
                  "kind": {
                    "const": "stylesheet-entry"
                  },
                  "contract": {
                    "const": "library-styles-v1"
                  }
                },
                "required": ["kind", "contract"]
              }
            }
          }
        },
        "else": {
          "properties": {
            "integrations": {
              "contains": {
                "properties": {
                  "kind": {
                    "const": "layout"
                  },
                  "contract": {
                    "const": "layout-v1"
                  }
                },
                "required": ["kind", "contract"]
              }
            }
          }
        }
      }
    }
  ]
}
