    "sha256": "d3dc797f513a4555791676cca10c31b501a57e92ed141c14b8adc334a48ef49a"
  },
  "rules": [
    {
      "selectors": [".kit-alert"],
      "declarations": [
        {
          "property": "box-sizing",
          "value": "border-box"
        },
        {
          "property": "border",
          "value": "var(--kit-border-width) solid var(--kit-color-border)"
        },
        {
          "property": "border-radius",
          "value": "var(\n    --kit-alert-radius,\n    var(--kit-radius-surface, var(--kit-radius-default, var(--kit-radius-md)))\n  )"
        },
        {
          "property": "padding",
          "value": "0.75rem 1rem"
        },
        {
          "property": "background",
          "value": "var(--kit-color-surface-raised)"
        },
        {
          "property": "color",
          "value": "var(--kit-color-text)"
        }
      ]
    }
  ]
}
