---
interface Props {
  title: string;
}
const { title } = Astro.props;
const witness = process.env.OWNED_FIXTURE_WITNESS ?? "unqualified";
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="fixture-witness" content={witness} />
    <title>{title}</title>
  </head>
  <body>
    <header>
      <slot name="banner" />
    </header>
    <div id="application-content">
      <slot />
    </div>
    <footer data-testid="layout-footer">Application-owned footer</footer>
  </body>
</html>
