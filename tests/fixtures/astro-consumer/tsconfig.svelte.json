{
  "compilerOptions": {
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "bundler",
    "strict": true,
    "skipLibCheck": false,
    "verbatimModuleSyntax": true,
    "allowJs": true,
    "checkJs": true,
    "resolveJsonModule": true,
    "esModuleInterop": true,
    "types": ["svelte", "node"]
  },
  "include": ["src/**/*.svelte", "src/**/*.ts"],
  "exclude": ["dist", "node_modules", ".native-build"]
}
