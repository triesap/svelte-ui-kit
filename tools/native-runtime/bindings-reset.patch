diff --git a/src/internal/client/dom/elements/bindings/input.js b/src/internal/client/dom/elements/bindings/input.js
--- a/src/internal/client/dom/elements/bindings/input.js
+++ b/src/internal/client/dom/elements/bindings/input.js
@@ -164,2 +164,5 @@
-		// TODO better default value handling
-		() => set(is_checkbox ? [] : null)
+		() => {
+			// Preserve native checked values, including selected undefined.
+			const values = get_binding_group_value(binding_group, undefined, true);
+			set(is_checkbox ? values : values.length === 0 ? null : values[0]);
+		}
@@ -297,3 +300,36 @@
-	listen_to_event_and_reset_event(input, 'change', () => {
-		set(input.files);
-	});
+	listen_to_event_and_reset_event(
+		input,
+		'change',
+		() => {
+			set(input.files);
+		},
+		() => {
+			const current = input.files;
+			if (current === null || current !== get()) {
+				set(current);
+				return;
+			}
+			// A reset can mutate the same live FileList without invalidating
+			// reactive state. Refresh the list, never the actual File objects.
+			const view = /** @type {(Window & Partial<Pick<typeof globalThis, 'DataTransfer'>>) | null} */ (
+				input.ownerDocument.defaultView
+			);
+			const Transfer = view?.DataTransfer;
+			if (typeof Transfer !== 'function') {
+				throw new Error('File binding reset requires DataTransfer in the input document.');
+			}
+			const snapshot = new Transfer();
+			const copy_error = 'File binding reset could not preserve native files.';
+			for (const file of current) {
+				if (snapshot.items.add(file) === null) throw new Error(copy_error);
+			}
+			const refreshed = snapshot.files;
+			if (
+				refreshed.length !== current.length ||
+				Array.from(current).some((file, index) => refreshed[index] !== file)
+			) {
+				throw new Error(copy_error);
+			}
+			set(refreshed);
+		}
+	);
